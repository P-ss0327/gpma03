-bottom:unset;\">\r\n\t\t\t\t\t\t<section style=\"background-color:rgb(242, 246, 255);padding:10px 12px;box-sizing:border-box;margin-bottom:unset;\">\r\n\t\t\t\t\t\t\t<section style=\"line-height: 1.75em; letter-spacing: 1.5px; background-color: transparent; padding-bottom: 6px; box-sizing: border-box; margin-bottom: unset;\">\r\n\t\t\t\t\t\t\t\t<p style=\"line-height:1.75em;font-size:17px;text-indent:2.23529em;\">\r\n\t\t\t\t\t\t\t\t\t国务院印发《2030年前碳达峰行动方案》，明确了碳达峰工作的总体要求、主要目标和重点任务。</p>\r\n\t\t\t\t\t\t\t</section>\r\n\t\t\t\t\t\t</section>\r\n\t\t\t\t\t</section>\r\n\t\t\t\t</section>\r\n\t\t\t</section>\r\n\t\t\t<section style=\"margin-bottom:unset;\">\r\n\t\t\t\t<section style=\"margin:10px auto;display:flex;justify-content:flex-start;\">\r\n\t\t\t\t\t<section style=\"display:flex;margin-bottom:unset;\">\r\n\t\t\t\t\t\t<section style=\"display:flex;z-index:3;margin-bottom:unset;\">\r\n\t\t\t\t\t\t\t<section style=\"background-image:linear-gradient(to right, rgb(247, 148, 98), rgb(247, 148, 98));background-position:initial;background-size:initial;background-repeat:initial;background-attachment:initial;background-origin:initial;padding:9px 20px 9px 30px;box-sizing:border-box;margin-bottom:unset;background-clip:initial;-webkit-background-clip:initial;\">\r\n\t\t\t\t\t\t\t\t<section style=\"font-size:16px;color:rgb(255, 255, 255);text-align:center;margin-bottom:unset;\">\r\n\t\t\t\t\t\t\t\t\t<span style=\"font-size:18px;\"><strong data-brushtype=\"text\">2021～2025年</strong></span></section>\r\n\t\t\t\t\t\t\t</section>\r\n\t\t\t\t\t\t\t<section style=\"flex-shrink:0;margin-bottom:unset;\">\r\n\t\t\t\t\t\t\t\t<section style=\"width:20px;height:40px;background-color:rgb(247, 148, 98);clip-path:polygon(0px 0%, 100% 50%, 0% 100%);margin-bottom:unset;overflow:hidden;transform:scaleX(1.1);-webkit-transform:scaleX(1.1);-moz-transform:scaleX(1.1);-ms-transform:scaleX(1.1);-o-transform:scaleX(1.1);\">\r\n\t\t\t\t\t\t\t\t\t&nbsp;</section>\r\n\t\t\t\t\t\t\t</section>\r\n\t\t\t\t\t\t</section>\r\n\t\t\t\t\t\t<section style=\"flex-shrink:0;margin-left:-6px;margin-bottom:unset;\">\r\n\t\t\t\t\t\t\t<section style=\"width:20px;height:40px;background-image:linear-gradient(to left, rgb(255, 171, 61), rgb(255, 255, 255));background-position:initial;background-size:initial;background-repeat:initial;background-attachment:initial;background-origin:initial;clip-path:polygon(0px 0%, 100% 50%, 0% 100%);line-height:0;margin-bottom:unset;overflow:hidden;transform:scaleX(1.1);-webkit-transform:scaleX(1.1);-moz-transform:scaleX(1.1);-ms-transform:scaleX(1.1);-o-transform:scaleX(1.1);background-clip:initial;-webkit-background-clip:initial;\">\r\n\t\t\t\t\t\t\t\t&nbsp;</section>\r\n\t\t\t\t\t\t</section>\r\n\t\t\t\t\t</section>\r\n\t\t\t\t</section>\r\n\t\t\t\t<section style=\"display:flex;align-items:center;margin-bottom:unset;\">\r\n\t\t\t\t\t<section style=\"flex-shrink:0;z-index:3;padding-bottom:15px;box-sizing:border-box;margin-bottom:unset;\">\r\n\t\t\t\t\t\t<section style=\"width:12px;height:12px;border-radius:100%;background-color:rgb(255, 171, 61);box-sizing:border-box;margin-bottom:unset;overflow:hidden;\">\r\n\t\t\t\t\t\t\t&nbsp;</section>\r\n\t\t\t\t\t</section>\r\n\t\t\t\t\t<section data-width=\"100%\" style=\"border-left:1px dashed rgb(247, 148, 98);padding-left:15px;margin-left:-6px;width:100%;padding-bottom:15px;box-sizing:border-box;margin-bottom:unset;\">\r\n\t\t\t\t\t\t<section style=\"background-color:rgb(242, 246, 255);padding:10px 12px;box-sizing:border-box;margin-bottom:unset;\">\r\n\t\t\t\t\t\t\t<section style=\"line-height: 1.75em; letter-spacing: 1.5px; background-color: transparent; padding-bottom: 6px; box-sizing: border-box; margin-bottom: unset;\">\r\n\t\t\t\t\t\t\t\t<p style=\"line-height:1.75em;font-size:17px;text-indent:2.23529em;\">\r\n\t\t\t\t\t\t\t\t\t我国构建了符合国情、相对完备的降碳政策和行动体系，重点行业领域绿色低碳转型步伐加快，绿色低碳技术、产品、装备、材料、燃料等供给能力显著提升，建成全球覆盖温室气体排放规模最大的碳定价机制，形成全球规模最大的可再生能源电力系统。</p>\r\n\t\t\t\t\t\t\t</section>\r\n\t\t\t\t\t\t</section>\r\n\t\t\t\t\t</section>\r\n\t\t\t\t</section>\r\n\t\t\t</section>\r\n\t\t\t<section style=\"margin-bottom:unset;\">\r\n\t\t\t\t<section style=\"margin:10px auto;display:flex;justify-content:flex-start;\">\r\n\t\t\t\t\t<section style=\"display:flex;margin-bottom:unset;\">\r\n\t\t\t\t\t\t<section style=\"display:flex;z-index:3;margin-bottom:unset;\">\r\n\t\t\t\t\t\t\t<section style=\"background-image:linear-gradient(to right, rgb(247, 148, 98), rgb(247, 148, 98));background-position:initial;background-size:initial;background-repeat:initial;background-attachment:initial;background-origin:initial;padding:9px 20px 9px 30px;box-sizing:border-box;margin-bottom:unset;background-clip:initial;-webkit-background-clip:initial;\">\r\n\t\t\t\t\t\t\t\t<section style=\"font-size:16px;color:rgb(255, 255, 255);text-align:center;margin-bottom:unset;\">\r\n\t\t\t\t\t\t\t\t\t<span style=\"font-size:18px;\"><strong data-brushtype=\"text\">2026年3月</strong></span></section>\r\n\t\t\t\t\t\t\t</section>\r\n\t\t\t\t\t\t\t<section style=\"flex-shrink:0;margin-bottom:unset;\">\r\n\t\t\t\t\t\t\t\t<section style=\"width:20px;height:40px;background-color:rgb(247, 148, 98);clip-path:polygon(0px 0%, 100% 50%, 0% 100%);margin-bottom:unset;overflow:hidden;transform:scaleX(1.1);-webkit-transform:scaleX(1.1);-moz-transform:scaleX(1.1);-ms-transform:scaleX(1.1);-o-transform:scaleX(1.1);\">\r\n\t\t\t\t\t\t\t\t\t&nbsp;</section>\r\n\t\t\t\t\t\t\t</section>\r\n\t\t\t\t\t\t</section>\r\n\t\t\t\t\t\t<section style=\"flex-shrink:0;margin-left:-6px;margin-bottom:unset;\">\r\n\t\t\t\t\t\t\t<section style=\"width:20px;height:40px;background-image:linear-gradient(to left, rgb(255, 171, 61), rgb(255, 255, 255));background-position:initial;background-size:initial;background-repeat:initial;background-attachment:initial;background-origin:initial;clip-path:polygon(0px 0%, 100% 50%, 0% 100%);line-height:0;margin-bottom:unset;overflow:hidden;transform:scaleX(1.1);-webkit-transform:scaleX(1.1);-moz-transform:scaleX(1.1);-ms-transform:scaleX(1.1);-o-transform:scaleX(1.1);background-clip:initial;-webkit-background-clip:initial;\">\r\n\t\t\t\t\t\t\t\t&nbsp;</section>\r\n\t\t\t\t\t\t</section>\r\n\t\t\t\t\t</section>\r\n\t\t\t\t</section>\r\n\t\t\t\t<section style=\"display:flex;align-items:center;margin-bottom:unset;\">\r\n\t\t\t\t\t<section style=\"flex-shrink:0;z-index:3;padding-bottom:15px;box-sizing:border-box;margin-bottom:unset;\">\r\n\t\t\t\t\t\t<section style=\"width:12px;height:12px;border-radius:100%;background-color:rgb(255, 171, 61);box-sizing:border-box;margin-bottom:unset;overflow:hidden;\">\r\n\t\t\t\t\t\t\t&nbsp;</section>\r\n\t\t\t\t\t</section>\r\n\t\t\t\t\t<section data-width=\"100%\" style=\"border-left:1px dashed rgb(247, 148, 98);padding-left:15px;margin-left:-6px;width:100%;padding-bottom:15px;box-sizing:border-box;margin-bottom:unset;\">\r\n\t\t\t\t\t\t<section style=\"background-color:rgb(242, 246, 255);padding:10px 12px;box-sizing:border-box;margin-bottom:unset;\">\r\n\t\t\t\t\t\t\t<section style=\"line-height: 1.75em; letter-spacing: 1.5px; background-color: transparent; padding-bottom: 6px; box-sizing: border-box; margin-bottom: unset;\">\r\n\t\t\t\t\t\t\t\t<p style=\"line-height:1.75em;font-size:17px;text-indent:2.23529em;\">\r\n\t\t\t\t\t\t\t\t\t&ldquo;十五五&rdquo;规划《纲要》正式发布，将&ldquo;积极稳妥推进和实现碳达峰&rdquo;作为独立章节，明确了&ldquo;十五五&rdquo;时期碳达峰工作的总体要求和重点任务。</p>\r\n\t\t\t\t\t\t\t</section>\r\n\t\t\t\t\t\t</section>\r\n\t\t\t\t\t</section>\r\n\t\t\t\t</section>\r\n\t\t\t</section>\r\n\t\t</section>\r\n\t</section>\r\n\t<p style=\"font-size:16px;text-decoration-thickness:auto;text-decoration-style:solid;caret-color:#000000;color:#000000;line-height:1.75;font-family:Calibri;\">\r\n\t\t&nbsp;</p>\r\n\t<section class=\"_editor\" data-style-id=\"71467\" data-support=\"96编辑器\" style=\"margin-bottom:unset;\">\r\n\t\t<section style=\"background-color:rgb(247, 148, 98);padding:6px 7px;margin-top:10px;box-sizing:border-box;margin-bottom:unset;\">\r\n\t\t\t<section style=\"background-color:rgb(254, 254, 254);border-radius:45px;padding:5px 20px;display:flex;justify-content:space-between;align-items:center;box-sizing:border-box;margin-bottom:unset;\">\r\n\t\t\t\t<p style=\"color:#000000;font-size:18px;\">\r\n\t\t\t\t\t<strong>发挥碳达峰碳中和战略牵引作用</strong></p>\r\n\t\t\t\t<section style=\"width:2em;margin-top:-40px;margin-bottom:unset;\">\r\n\t\t\t\t\t<p>\r\n\t\t\t\t\t\t&nbsp;</p>\r\n\t\t\t\t</section>\r\n\t\t\t</section>\r\n\t\t</section>\r\n\t\t<section class=\"_li\" style=\"margin-top:15px;margin-bottom:unset;\">\r\n\t\t\t<section style=\"border:1px solid rgb(0, 0, 0);padding:20px 15px;box-sizing:border-box;margin-bottom:unset;\">\r\n\t\t\t\t<p style=\"line-height:1.75em;margin-bottom:16px;font-size:17px;text-indent:2.11765em;\">\r\n\t\t\t\t\t会议指出，<strong>要发挥碳达峰碳中和战略牵引作用。</strong></p>\r\n\t\t\t\t<p style=\"line-height:1.75em;margin-bottom:16px;font-size:17px;text-indent:2.11765em;\">\r\n\t\t\t\t\t<strong>从&ldquo;能耗双控&rdquo;向&ldquo;碳排放双控&rdquo;转变，是发挥碳达峰碳中和战略牵引作用的关键制度抓手。</strong></p>\r\n\t\t\t\t<p style=\"line-height:1.75em;margin-bottom:16px;font-size:17px;text-indent:2.11765em;\">\r\n\t\t\t\t\t党的二十届四中全会要求实施碳排放总量和强度双控制度。&ldquo;十五五&rdquo;规划《纲要》明确提出&ldquo;全面实施碳排放总量和强度双控制度&rdquo;，明确单位GDP二氧化碳排放降低17%、单位GDP能耗下降10%左右，标志着碳排放双控进入可量化、可考核的硬约束阶段。</p>\r\n\t\t\t\t<p style=\"line-height:1.75em;margin-bottom:16px;font-size:17px;text-indent:2.11765em;\">\r\n\t\t\t\t\t国家发展改革委主任郑栅洁在介绍和解读党的二十届四中全会精神时表示，&ldquo;过去我们是能耗双控制度，现在全面转向碳排放双控制度。这是全面绿色转型的&lsquo;指挥棒&rsquo;。&rdquo;</p>\r\n\t\t\t\t<p style=\"line-height:1.75em;margin-bottom:16px;font-size:17px;text-indent:2.11765em;\">\r\n\t\t\t\t\t国家层面的顶层设计掷地有声，地方实践也迅速响应。例如，四川省&ldquo;十五五&rdquo;规划《纲要》首次明确将&ldquo;含新量、含金量、含绿量&rdquo;作为高质量发展的核心衡量标准，到2030年新质生产力对经济增长的贡献率要突破60%，经济总量迈向10万亿级，单位GDP二氧化碳排放要降低17%，非化石能源消费占比要达到25%。</p>\r\n\t\t\t\t<p style=\"line-height:1.75em;margin-bottom:16px;font-size:17px;text-indent:2.11765em;\">\r\n\t\t\t\t\t<strong>与此同时，开展评价考核也将进一步发挥碳达峰碳中和的战略牵引作用，加快推动能源转型和产业升级，加紧经济社会发展全面绿色转型，降低全社会对化石能源的依赖。</strong></p>\r\n\t\t\t\t<p style=\"line-height:1.75em;margin-bottom:16px;font-size:17px;text-indent:2.11765em;\">\r\n\t\t\t\t\t今年4月，中共中央办公厅、国务院办公厅正式印发《碳达峰碳中和综合评价考核办法》。国家发展改革委相关负责人表示，该《办法》作为碳排放双控制度体系的关键制度，正式将碳排放双控要求纳入党内法规体系，将有力督促地方党委和政府坚决扛起碳达峰碳中和责任、抓好工作落实，确保如期实现&ldquo;双碳&rdquo;目标。</p>\r\n\t\t\t\t<p style=\"line-height:1.75em;margin-bottom:16px;font-size:17px;text-indent:2.11765em;\">\r\n\t\t\t\t\t地方层面的探索也陆续展开。2026年6月，上海市发布《关于组织开展2025年度上海市重点单位报送能源利用状况报告和温室气体排放报告以及能耗、碳排放总量和强度双控目标评价考核等相关工作的通知》，对重点单位碳排放总量和强度双控目标进行评价考核。</p>\r\n\t\t\t\t<p style=\"line-height: 1.8;\">\r\n\t\t\t\t\t&nbsp;</p>\r\n\t\t\t</section>\r\n\t\t</section>\r\n\t</section>\r\n\t<p style=\"font-size:16px;text-decoration-thickness:auto;text-decoration-style:solid;caret-color:#000000;color:#000000;line-height:1.75;font-family:Calibri;\">\r\n\t\t&nbsp;</p>\r\n\t<section class=\"_editor\" data-style-id=\"71467\" data-support=\"96编辑器\" style=\"margin-bottom:unset;\">\r\n\t\t<section style=\"background-color:rgb(247, 148, 98);padding:6px 7px;margin-top:10px;margin-bottom:unset;box-sizing:border-box;\">\r\n\t\t\t<section style=\"background-color:rgb(254, 254, 254);border-radius:45px;padding:5px 20px;display:flex;justify-content:space-between;align-items:center;margin-bottom:unset;box-sizing:border-box;\">\r\n\t\t\t\t<p style=\"color:#000000;font-size:18px;\">\r\n\t\t\t\t\t<strong>促进经济结构转型升级</strong></p>\r\n\t\t\t\t<section style=\"width:2em;margin-top:-40px;margin-bottom:unset;\">\r\n\t\t\t\t\t<p>\r\n\t\t\t\t\t\t&nbsp;</p>\r\n\t\t\t\t</section>\r\n\t\t\t</section>\r\n\t\t</section>\r\n\t\t<section class=\"_li\" style=\"margin-top:15px;margin-bottom:unset;\">\r\n\t\t\t<section style=\"border:1px solid rgb(0, 0, 0);padding:20px 15px;margin-bottom:unset;box-sizing:border-box;\">\r\n\t\t\t\t<p style=\"line-height:1.75em;font-size:17px;text-indent:2.11765em;margin-bottom:24px;\">\r\n\t\t\t\t\t会议明确要求，促进经济结构转型升级。&ldquo;十五五&rdquo;时期，我国正以绿色转型为引擎，驱动产业结构向高端化、智能化、绿色化方向跃升。</p>\r\n\t\t\t\t<p style=\"line-height: 1.8; text-align: center;\">\r\n\t\t\t\t\t<img alt=\"\" src=\"https://www.gpma.org.cn/userfiles/1/images/cms/article/202607/1-2.jpg\" style=\"width: 100%;\" /></p>\r\n\t\t\t\t<p style=\"line-height: 1.8;\">\r\n\t\t\t\t\t<span style=\"font-size:15px;\"><span style=\"color: rgb(136, 136, 136);\">近年来，内蒙古呼和浩特市立足区位条件和风光新能源资源禀赋，通过实施绿电直供与&ldquo;源网荷储&rdquo;一体化等项目，持续推进绿色电力与算力协同布局。图为</span><span style=\"color:#888888;\">在内蒙古中科超算科技有限公司，工作人员巡检算力设备。新华社</span></span></p>\r\n\t\t\t\t<p style=\"margin-top:24px;line-height:1.75em;margin-bottom:16px;font-size:17px;text-indent:2.11765em;\">\r\n\t\t\t\t\t<strong>当前，能源领域排放占二氧化碳排放的80%以上，是减排的主战场。</strong>近日，国家发展改革委、国家能源局印发《新型能源体系建设&ldquo;十五五&rdquo;规划》，明确到2030年初步建成清洁低碳安全高效的新型能源体系，有力支撑能源强国建设。</p>\r\n\t\t\t\t<p style=\"line-height:1.75em;margin-bottom:16px;font-size:17px;text-indent:2.11765em;\">\r\n\t\t\t\t\t值得注意的是，&ldquo;十五五&rdquo;时期能源重点项目和新业态投资总规模超过20万亿元。其中，在推进新质生产力发展方面，布局一批绿色氢氨醇生产基地项目，拓展多用户绿电直连场景，建设包括新型储能、综合能源服务、虚拟电厂、算电协同等新产业新业态项目。国家发展改革委党组成员、国家能源局局长王宏志表示，这些新项目&ldquo;十五五&rdquo;投资规模将超过2万亿元，<strong>既是拉动投资增长的&ldquo;新引擎&rdquo;，也为能源转型发展打开&ldquo;新空间&rdquo;。</strong></p>\r\n\t\t\t\t<p style=\"line-height:1.75em;margin-bottom:16px;font-size:17px;text-indent:2.11765em;\">\r\n\t\t\t\t\t<strong>工业是能源消耗和碳排放的&ldquo;大户&rdquo;。</strong>对此，国家发展改革委等五部门日前联合印发《关于开展重点行业节能降碳改造攻坚三年行动的通知》，组织开展钢铁、电解铝、水泥、平板玻璃、炼油、乙烯、合成氨、甲醇、煤电等9个重点行业节能降碳改造攻坚三年行动，加力推进节能降碳工作。</p>\r\n\t\t\t\t<p style=\"line-height:1.75em;margin-bottom:16px;font-size:17px;text-indent:2.11765em;\">\r\n\t\t\t\t\t<strong>技术创新是产业绿色转型的核心驱动力</strong>。钢铁行业实施&ldquo;极致能效&rdquo;工程，建材行业推进&ldquo;六零&rdquo;工厂建设，有色行业着力提高能源利用效率，化工行业加快发展新材料、高端专用化学品等战略性新兴产业。在石化领域，田湾核电蒸汽供能项目每年可为连云港石化产业基地提供480万吨工业蒸汽，相当于每年减少燃烧标准煤40万吨，等效减排二氧化碳107万吨。</p>\r\n\t\t\t\t<p style=\"line-height:1.75em;margin-bottom:16px;font-size:17px;text-indent:2.11765em;\">\r\n\t\t\t\t\t<strong>碳市场扩围正在倒逼高耗能行业深度转型，市场机制在促进工业绿色低碳转型方面正发挥日益重要的作用。</strong>2025年，全国碳市场迎来了具有里程碑意义的首次行业扩围，在原有的电力行业基础上，钢铁、水泥、铝冶炼三大高耗能行业被正式纳入碳市场管理。国家积极推进碳市场有关顶层设计，碳排放权交易更趋活跃，成为实现碳达峰碳中和的有力举措。截至2025年底，全国碳排放权交易市场实现平稳有序运行，碳排放权交易市场累计成交量8.65亿吨，累计成交额达576.63亿元。</p>\r\n\t\t\t\t<p style=\"line-height:1.75em;margin-bottom:16px;font-size:17px;text-indent:2.11765em;\">\r\n\t\t\t\t\t此外，&ldquo;十五五&rdquo;时期，在推进建筑节能降碳方面，加强新建建筑运营管理，推广超低能耗建筑，推进既有建筑节能降碳改造，持续优化建筑用能结构；在加快交通运输低碳转型方面，将大力推广电动货运车辆、绿色燃料货运车辆，打造一批零碳公路运输通道和零碳水运。</p>\r\n\t\t\t\t<p>\r\n\t\t\t\t\t&nbsp;</p>\r\n\t\t\t</section>\r\n\t\t</section>\r\n\t</section>\r\n\t<p style=\"font-size:16px;text-decoration-thickness:auto;text-decoration-style:solid;caret-color:#000000;color:#000000;line-height:1.75;font-family:Calibri;\">\r\n\t\t&nbsp;</p>\r\n\t<section class=\"_editor\" data-style-id=\"71467\" data-support=\"96编辑器\" style=\"margin-bottom:unset;\">\r\n\t\t<section style=\"background-color:rgb(247, 148, 98);padding:6px 7px;margin-top:10px;margin-bottom:unset;box-sizing:border-box;\">\r\n\t\t\t<section style=\"background-color:rgb(254, 254, 254);border-radius:45px;padding:5px 20px;display:flex;justify-content:space-between;align-items:center;margin-bottom:unset;box-sizing:border-box;\">\r\n\t\t\t\t<p style=\"color:#000000;font-size:18px;\">\r\n\t\t\t\t\t<strong>打造绿色低碳经济增长新引擎</strong></p>\r\n\t\t\t\t<section style=\"width:2em;margin-top:-40px;margin-bottom:unset;\">\r\n\t\t\t\t\t<p>\r\n\t\t\t\t\t\t&nbsp;</p>\r\n\t\t\t\t</section>\r\n\t\t\t</section>\r\n\t\t</section>\r\n\t\t<section class=\"_li\" style=\"margin-top:15px;margin-bottom:unset;\">\r\n\t\t\t<section style=\"border:1px solid rgb(0, 0, 0);padding:20px 15px;margin-bottom:unset;box-sizing:border-box;\">\r\n\t\t\t\t<p style=\"line-height:1.75em;margin-bottom:16px;font-size:17px;text-indent:2.11765em;\">\r\n\t\t\t\t\t会议提出，&ldquo;打造更多绿色经济增长点&rdquo;。</p>\r\n\t\t\t\t<p style=\"line-height:1.75em;margin-bottom:16px;font-size:17px;text-indent:2.11765em;\">\r\n\t\t\t\t\t在业内专家看来，《行动方案》的颁布明确了&ldquo;双碳&rdquo;目标的经济价值转化路径：将减排压力转化为产业机遇，将环境成本转化为竞争优势，在绿色转型中培育新质生产力。</p>\r\n\t\t\t\t<p style=\"line-height:1.75em;margin-bottom:16px;font-size:17px;text-indent:2.11765em;\">\r\n\t\t\t\t\t他表示，通过产业政策引导和扶持发展绿色低碳产业，可以创造GDP和利润的增长点，为践行绿色低碳发展理念提供源源不断的动力。</p>\r\n\t\t\t\t<p style=\"line-height: 1.8; text-align: center;\">\r\n\t\t\t\t\t<img alt=\"\" src=\"https://www.gpma.org.cn/userfiles/1/images/cms/article/202607/1-3.jpg\" style=\"width: 1080px; height: 729px;\" /></p>\r\n\t\t\t\t<p style=\"line-height:1.8;font-size:15px;\">\r\n\t\t\t\t\t<span style=\"color:#888888;caret-color:red;\">近年来，依托上汽通用五菱带动，广西柳州建成汽车零部件&ldquo;以竹代塑&rdquo;相关产业链。该项目通过技术创新，将竹资源转化为汽车零部件原材料，相较传统塑料件，竹纤维部件能减少车内挥发性有机物，低碳又健康。图为</span><span style=\"color:#888888;caret-color:red;\">完成竹纤维材料汽车零部件组装的汽车陆续下线。 新华社</span></p>\r\n\t\t\t\t<p style=\"line-height:1.75em;margin-bottom:16px;font-size:17px;text-indent:2.11765em;\">\r\n\t\t\t\t\t<strong>氢能和绿色燃料正成为最具潜力的新增长点。</strong></p>\r\n\t\t\t\t<p style=\"line-height:1.75em;margin-bottom:16px;font-size:17px;text-indent:2.11765em;\">\r\n\t\t\t\t\t氢能作为构建绿色低碳产业体系、打造产业转型升级的新增长点，已被《氢能产业发展中长期规划（2021&mdash;2035年）》明确为发展战略性新兴产业的重点方向。</p>\r\n\t\t\t\t<p style=\"line-height:1.75em;margin-bottom:16px;font-size:17px;text-indent:2.11765em;\">\r\n\t\t\t\t\t与此同时，绿色燃料作为氢能的下游重要载体一同亮相，意味着其已上升到国家战略高度。2026年，&ldquo;绿色燃料&rdquo;首次被写入《政府工作报告》，成为培育绿色低碳经济新增长点的重要方向。</p>\r\n\t\t\t\t<p style=\"line-height:1.75em;margin-bottom:16px;font-size:17px;text-indent:2.11765em;\">\r\n\t\t\t\t\t在吉林洮南，当地依托玉米秸秆资源搭配风电制氢，经化工转化产出绿色甲醇。这种被称作&ldquo;液态阳光&rdquo;的新型燃料，全生命周期碳排放量较传统柴油降幅超90%。</p>\r\n\t\t\t\t<p style=\"line-height:1.75em;margin-bottom:16px;font-size:17px;text-indent:2.11765em;\">\r\n\t\t\t\t\t当前国内甲醇全产业链发展势头强劲：今年一季度，我国新增绿色船舶订单占全球市场份额达80.2%；甲醇重卡单月销量同比增长超300%；全国落地规划的绿色甲醇项目数量超200个。配套基础设施建设同步提速，截至2025年末，全国已建成甲醇加注站900余座。</p>\r\n\t\t\t\t<p style=\"line-height:1.75em;margin-bottom:16px;font-size:17px;text-indent:2.11765em;\">\r\n\t\t\t\t\t<strong>零碳园区和零碳工厂是绿色增长的重要载体。</strong>从福建宁德到云南曲靖，从内蒙古镕锂电池材料项目到内蒙古百川光热科技，各地正以绿色技术&ldquo;上新&rdquo;、绿色产业&ldquo;焕新&rdquo;为抓手，催生新产业、打造新的经济增长点。在内蒙古自治区伊金霍洛旗，高端石墨材料项目首期达产后预计年产值30亿元，新增就业岗位500个，成为绿色制造产业驱动地方经济增长的生动缩影。</p>\r\n\t\t\t\t<p style=\"line-height:1.75em;margin-bottom:16px;font-size:17px;text-indent:2.11765em;\">\r\n\t\t\t\t\t<strong>绿色消费与绿色贸易构建内外循环新动力</strong>。业内专家表示，&ldquo;十五五&rdquo;时期，在扩大内需方面，通过健全绿色消费激励机制、推广绿色低碳生活方式，持续增强内需对经济增长的拉动力。在对外开放方面，发展绿色贸易纳入国际合作重点，通过提升贸易绿色标准、深化绿色产业链协同，不断增强我国在全球绿色低碳治理中的竞争力。</p>\r\n\t\t\t\t<p>\r\n\t\t\t\t\t&nbsp;</p>\r\n\t\t\t</section>\r\n\t\t</section>\r\n\t</section>\r\n\t<p style=\"font-size:16px;text-decoration-thickness:auto;text-decoration-style:solid;caret-color:#000000;color:#000000;line-height:1.75;font-family:Calibri;\">\r\n\t\t&nbsp;</p>\r\n</section>\r\n<p>\r\n\t&nbsp;</p>\r\n<p>\r\n\t&nbsp;</p>"}