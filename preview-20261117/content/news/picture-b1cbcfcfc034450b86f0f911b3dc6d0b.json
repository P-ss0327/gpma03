0, 0); box-sizing: border-box; margin-bottom: unset;\">\r\n\t\t\t\t\t\t\t\t<section data-nest-level=\"9\" style=\"font-variant-numeric: normal; font-variant-east-asian: normal; font-variant-alternates: normal; font-kerning: auto; font-optical-sizing: auto; font-feature-settings: normal; font-variation-settings: normal; font-variant-position: normal; font-stretch: normal; line-height: 24px; flex: 0 1 auto; flex-direction: row; justify-content: normal; align-items: normal; background: none 0% 0% / auto repeat scroll padding-box border-box rgba(0, 0, 0, 0); box-sizing: border-box; margin-bottom: unset;\">\r\n\t\t\t\t\t\t\t\t\t<p style=\"margin-bottom: 10px; text-indent: 2.25em;\">\r\n\t\t\t\t\t\t\t\t\t\t<span style=\"font-size:17px;\">持有住建部房建、市政、机电安装三大类监理甲级资质，同时具备电力、化工石油、水利、文物保护工程监理乙级资质，拥有环境工程监理乙级评价、工程咨询乙级资信、工程造价 AAA 信用等级等多项权威证书；取得七项管理体系认证、国家高新技术企业认定，连续二十九年获评广东省 &ldquo;守合同、重信用&rdquo; 企业，手握多项专利与软件著作权。</span></p>\r\n\t\t\t\t\t\t\t\t\t<section data-nest-level=\"10\" style=\"font-variant-numeric: normal; font-variant-east-asian: normal; font-variant-alternates: normal; font-kerning: auto; font-optical-sizing: auto; font-feature-settings: normal; font-variation-settings: normal; font-variant-position: normal; font-stretch: normal; line-height: 24px; flex: 0 1 auto; flex-direction: row; justify-content: normal; align-items: normal; background: none 0% 0% / auto repeat scroll padding-box border-box rgba(0, 0, 0, 0); box-sizing: border-box; height: 0px; margin-bottom: unset; overflow: hidden;\">\r\n\t\t\t\t\t\t\t\t\t\t&nbsp;</section>\r\n\t\t\t\t\t\t\t\t\t<p style=\"text-indent:2.25em;\">\r\n\t\t\t\t\t\t\t\t\t\t<span style=\"font-size:17px;\">公司可承接房建、市政路桥隧、生态园林、环保水利等各类工程监理业务，同步开展招标代理、政府采购、全过程造价咨询、项目代建、可行性研究编制、工程技术咨询等一站式综合技术服务。</span></p>\r\n\t\t\t\t\t\t\t\t\t<p data-nest-level=\"10\">\r\n\t\t\t\t\t\t\t\t\t\t&nbsp;</p>\r\n\t\t\t\t\t\t\t\t\t<p data-nest-level=\"10\">\r\n\t\t\t\t\t\t\t\t\t\t&nbsp;</p>\r\n\t\t\t\t\t\t\t\t</section>\r\n\t\t\t\t\t\t\t</section>\r\n\t\t\t\t\t\t\t<section data-nest-level=\"8\" style=\"color: rgb(0, 0, 0); font-variant-numeric: normal; font-variant-east-asian: normal; font-variant-alternates: normal; font-kerning: auto; font-optical-sizing: auto; font-feature-settings: normal; font-variation-settings: normal; font-variant-position: normal; font-stretch: normal; font-size: 15px; line-height: 24px; font-family: ui-sans-serif, system-ui, sans-serif, &quot;Apple Color Emoji&quot;, &quot;Segoe UI Emoji&quot;, &quot;Segoe UI Symbol&quot;, &quot;Noto Color Emoji&quot;; flex: 0 1 auto; flex-direction: row; justify-content: normal; align-items: normal; background: none 0% 0% / auto repeat scroll padding-box border-box rgba(0, 0, 0, 0); box-sizing: border-box; margin-bottom: unset;\">\r\n\t\t\t\t\t\t\t\t<h3 data-nest-level=\"9\" style=\"font-variant-numeric: normal; font-variant-east-asian: normal; font-variant-alternates: normal; font-kerning: auto; font-optical-sizing: auto; font-feature-settings: normal; font-variation-settings: normal; font-variant-position: normal; font-weight: normal; font-stretch: normal; font-size: 17px; line-height: 24px; flex: 0 1 auto; flex-direction: row; justify-content: normal; align-items: normal; margin: 0px 0px 10px; background: none 0% 0% / auto repeat scroll padding-box border-box rgba(0, 0, 0, 0);\">\r\n\t\t\t\t\t\t\t\t\t<span style=\"font-weight: bold;\">二、团队与业务布局</span></h3>\r\n\t\t\t\t\t\t\t</section>\r\n\t\t\t\t\t\t\t<section data-nest-level=\"8\" style=\"color: rgb(0, 0, 0); font-variant-numeric: normal; font-variant-east-asian: normal; font-variant-alternates: normal; font-kerning: auto; font-optical-sizing: auto; font-feature-settings: normal; font-variation-settings: normal; font-variant-position: normal; font-stretch: normal; font-size: 16px; line-height: 24px; font-family: ui-sans-serif, system-ui, sans-serif, &quot;Apple Color Emoji&quot;, &quot;Segoe UI Emoji&quot;, &quot;Segoe UI Symbol&quot;, &quot;Noto Color Emoji&quot;; flex: 0 1 auto; flex-direction: row; justify-content: normal; align-items: normal; background: none 0% 0% / auto repeat scroll padding-box border-box rgba(0, 0, 0, 0); box-sizing: border-box; margin-bottom: unset;\">\r\n\t\t\t\t\t\t\t\t<section data-nest-level=\"9\" style=\"font-variant-numeric: normal; font-variant-east-asian: normal; font-variant-alternates: normal; font-kerning: auto; font-optical-sizing: auto; font-feature-settings: normal; font-variation-settings: normal; font-variant-position: normal; font-stretch: normal; font-size: 15px; line-height: 24px; flex: 0 1 auto; flex-direction: row; justify-content: normal; align-items: normal; background: none 0% 0% / auto repeat scroll padding-box border-box rgba(0, 0, 0, 0); box-sizing: border-box; margin-bottom: unset;\">\r\n\t\t\t\t\t\t\t\t\t<p style=\"margin-bottom: 10px; text-indent: 2.4em;\">\r\n\t\t\t\t\t\t\t\t\t\t<span style=\"font-size:17px;\">公司下设八大职能部门、二十余个监理部，在珠三角及海南、广西、重庆、江西赣州等多地设立分公司，业务辐射全国并拓展至非洲地区。现有专业技术人员 460 名，其中正高级、高级工程师 53 人，中初级工程、经济类人才 168 人；各类注册执业人员近 200 名，全员持证上岗，专业覆盖建筑、结构、智能化、岩土、环保、造价等二十余个细分领域，擅长攻克工程高难度复杂技术难题。</span></p>\r\n\t\t\t\t\t\t\t\t\t<p data-nest-level=\"10\" style=\"margin-bottom: 10px;\">\r\n\t\t\t\t\t\t\t\t\t\t&nbsp;</p>\r\n\t\t\t\t\t\t\t\t</section>\r\n\t\t\t\t\t\t\t</section>\r\n\t\t\t\t\t\t\t<section data-nest-level=\"8\" style=\"color: rgb(0, 0, 0); font-variant-numeric: normal; font-variant-east-asian: normal; font-variant-alternates: normal; font-kerning: auto; font-optical-sizing: auto; font-feature-settings: normal; font-variation-settings: normal; font-variant-position: normal; font-stretch: normal; font-size: 15px; line-height: 24px; font-family: ui-sans-serif, system-ui, sans-serif, &quot;Apple Color Emoji&quot;, &quot;Segoe UI Emoji&quot;, &quot;Segoe UI Symbol&quot;, &quot;Noto Color Emoji&quot;; flex: 0 1 auto; flex-direction: row; justify-content: normal; align-items: normal; background: none 0% 0% / auto repeat scroll padding-box border-box rgba(0, 0, 0, 0); box-sizing: border-box; margin-bottom: unset;\">\r\n\t\t\t\t\t\t\t\t<h3 data-nest-level=\"9\" style=\"font-variant-numeric: normal; font-variant-east-asian: normal; font-variant-alternates: normal; font-kerning: auto; font-optical-sizing: auto; font-feature-settings: normal; font-variation-settings: normal; font-variant-position: normal; font-weight: normal; font-stretch: normal; font-size: 17px; line-height: 24px; flex: 0 1 auto; flex-direction: row; justify-content: normal; align-items: normal; margin: 0px 0px 10px; background: none 0% 0% / auto repeat scroll padding-box border-box rgba(0, 0, 0, 0);\">\r\n\t\t\t\t\t\t\t\t\t<span style=\"font-weight: bold;\">三、管理与发展成果</span></h3>\r\n\t\t\t\t\t\t\t</section>\r\n\t\t\t\t\t\t\t<section data-nest-level=\"8\" style=\"color: rgb(0, 0, 0); font-variant-numeric: normal; font-variant-east-asian: normal; font-variant-alternates: normal; font-kerning: auto; font-optical-sizing: auto; font-feature-settings: normal; font-variation-settings: normal; font-variant-position: normal; font-stretch: normal; font-size: 16px; line-height: 24px; font-family: ui-sans-serif, system-ui, sans-serif, &quot;Apple Color Emoji&quot;, &quot;Segoe UI Emoji&quot;, &quot;Segoe UI Symbol&quot;, &quot;Noto Color Emoji&quot;; flex: 0 1 auto; flex-direction: row; justify-content: normal; align-items: normal; background: none 0% 0% / auto repeat scroll padding-box border-box rgba(0, 0, 0, 0); box-sizing: border-box; margin-bottom: unset;\">\r\n\t\t\t\t\t\t\t\t<p style=\"margin-bottom: 10px; text-indent: 2.25em;\">\r\n\t\t\t\t\t\t\t\t\t<span style=\"font-size:17px;\">公司建立标准化、科学化工程管控体系，严格把控项目安全、质量、进度、投资四大核心目标，恪守 &ldquo;科学、公正、廉洁、优质&rdquo; 服务宗旨，秉持 &ldquo;诚、规&rdquo; 企业文化。</span></p>\r\n\t\t\t\t\t\t\t\t<section data-nest-level=\"10\" style=\"font-variant-numeric: normal; font-variant-east-asian: normal; font-variant-alternates: normal; font-kerning: auto; font-optical-sizing: auto; font-feature-settings: normal; font-variation-settings: normal; font-variant-position: normal; font-stretch: normal; line-height: 24px; flex: 0 1 auto; flex-direction: row; justify-content: normal; align-items: normal; background: none 0% 0% / auto repeat scroll padding-box border-box rgba(0, 0, 0, 0); box-sizing: border-box; height: 0px; margin-bottom: unset; overflow: hidden;\">\r\n\t\t\t\t\t\t\t\t\t&nbsp;</section>\r\n\t\t\t\t\t\t\t\t<p style=\"font-variant-numeric: normal; font-variant-east-asian: normal; font-variant-alternates: normal; font-kerning: auto; font-optical-sizing: auto; font-feature-settings: normal; font-variation-settings: normal; font-variant-position: normal; font-stretch: normal; line-height: 24px; flex: 0 1 auto; flex-direction: row; justify-content: normal; align-items: normal; background: none 0% 0% / auto repeat scroll padding-box border-box rgba(0, 0, 0, 0); box-sizing: border-box; text-indent: 2.25em;\">\r\n\t\t\t\t\t\t\t\t\t<span style=\"font-size:17px;\">公司竣工工程验收合格率 100%，咨询代理服务满意率 100%，工程优良率超 90%，近五年斩获省、市优良样板工程奖项超百项，依靠扎实技术与优质服务成为省内极具影响力的工程综合技术服务国企。</span></p>\r\n\t\t\t\t\t\t\t</section>\r\n\t\t\t\t\t\t\t<section data-nest-level=\"8\" style=\"color: rgb(0, 0, 0); font-variant-numeric: normal; font-variant-east-asian: normal; font-variant-alternates: normal; font-kerning: auto; font-optical-sizing: auto; font-feature-settings: normal; font-variation-settings: normal; font-variant-position: normal; font-stretch: normal; font-size: 16px; line-height: 24px; font-family: ui-sans-serif, system-ui, sans-serif, &quot;Apple Color Emoji&quot;, &quot;Segoe UI Emoji&quot;, &quot;Segoe UI Symbol&quot;, &quot;Noto Color Emoji&quot;; flex: 0 1 auto; flex-direction: row; justify-content: normal; align-items: normal; background: none 0% 0% / auto repeat scroll padding-box border-box rgba(0, 0, 0, 0); box-sizing: border-box; margin-bottom: unset;\">\r\n\t\t\t\t\t\t\t\t<section data-nest-level=\"9\" style=\"font-variant-numeric: normal; font-variant-east-asian: normal; font-variant-alternates: normal; font-kerning: auto; font-optical-sizing: auto; font-feature-settings: normal; font-varia