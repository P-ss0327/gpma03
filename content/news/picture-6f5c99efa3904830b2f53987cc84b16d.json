20px, 0px, 0px);\">\r\n\t\t\t<section style=\"display:inline-block;width:auto;vertical-align:top;min-width:10%;flex:0 0 auto;height:auto;align-self:flex-start;box-sizing:border-box;max-width:100% !important;margin-bottom:unset;\">\r\n\t\t\t\t<section style=\"text-align:justify;justify-content:flex-start;display:flex;flex-flow:row;box-sizing:border-box;margin-bottom:unset;\">\r\n\t\t\t\t\t<section style=\"display:inline-block;width:auto;vertical-align:top;min-width:10%;flex:0 0 auto;height:auto;background-color:rgb(13, 93, 183);align-self:flex-start;box-sizing:border-box;max-width:100% !important;margin-bottom:unset;\">\r\n\t\t\t\t\t\t<section style=\"margin:2px 0px 7px;box-sizing:border-box;\">\r\n\t\t\t\t\t\t\t<section style=\"color:rgba(255, 255, 255, 0.99);padding:0px 10px;letter-spacing:1px;line-height:2;box-sizing:border-box;margin-bottom:unset;\">\r\n\t\t\t\t\t\t\t\t<p>\r\n\t\t\t\t\t\t\t\t\t<span style=\"font-size:17px;\"><strong style=\"box-sizing:border-box;\"><span style=\"box-sizing:border-box;\">提升服务业数智化标准化融合化</span></strong><strong style=\"box-sizing:border-box;\"><span style=\"box-sizing:border-box;\">国际化水平</span></strong></span></p>\r\n\t\t\t\t\t\t\t</section>\r\n\t\t\t\t\t\t</section>\r\n\t\t\t\t\t</section>\r\n\t\t\t\t</section>\r\n\t\t\t\t<section style=\"font-size:0px;margin:0px 0%;box-sizing:border-box;\">\r\n\t\t\t\t\t<section style=\"display:inline-block;width:0px;height:0px;vertical-align:top;overflow:hidden;border-style:solid;border-width:3px;border-color:rgb(13, 93, 183) rgba(255, 255, 255, 0) rgba(255, 255, 255, 0) rgb(13, 93, 183);box-sizing:border-box;margin-bottom:unset;\">\r\n\t\t\t\t\t\t<svg style=\"float:left;line-height:0;width:0;vertical-align:top;\" viewbox=\"0 0 1 1\"></svg></section>\r\n\t\t\t\t</section>\r\n\t\t\t</section>\r\n\t\t</section>\r\n\t\t<section style=\"margin:0px 0% 10px;text-align:left;justify-content:flex-start;display:flex;flex-flow:row;box-sizing:border-box;\">\r\n\t\t\t<section data-width=\"100%\" style=\"display:inline-block;width:100%;vertical-align:top;border-left:2px solid rgb(13, 93, 183);border-bottom-left-radius:0px;padding:0px 0px 0px 2px;align-self:flex-start;flex:0 0 auto;box-sizing:border-box;margin-bottom:unset;\">\r\n\t\t\t\t<section style=\"text-align:justify;justify-content:flex-start;display:flex;flex-flow:row;box-sizing:border-box;margin-bottom:unset;\">\r\n\t\t\t\t\t<section data-width=\"100%\" style=\"display:inline-block;width:100%;vertical-align:top;border-width:0px 0px 0px 1px;border-left-style:solid;border-bottom-left-radius:0px;border-left-color:rgb(13, 93, 183);background-color:rgba(141, 191, 226, 0.15);align-self:flex-start;flex:0 0 auto;box-sizing:border-box;margin-bottom:unset;\">\r\n\t\t\t\t\t\t<section style=\"margin:30px 0% 10px;box-sizing:border-box;\">\r\n\t\t\t\t\t\t\t<section style=\"padding:0px 15px;line-height:2;letter-spacing:1.8px;font-size:15px;box-sizing:border-box;margin-bottom:unset;\">\r\n\t\t\t\t\t\t\t\t<p style=\"text-indent:2.53333em;\">\r\n\t\t\t\t\t\t\t\t\t<span style=\"font-size:17px;\">《意见》提出，围绕研发设计、检验检测、物流配送、批发贸易、咨询服务等重点环节，建设垂直行业工业互联网平台，利用&ldquo;小快轻准&rdquo;解决方案降低数智化门槛；围绕数据赋能，实施综合性重大场景和高价值应用场景项目，培育数智化转型服务商，打造数据、算法、场景协同应用标杆；推动建立国际性产业和标准组织，促进中国标准&ldquo;走出去&rdquo;。</span></p>\r\n\t\t\t\t\t\t\t</section>\r\n\t\t\t\t\t\t</section>\r\n\t\t\t\t\t</section>\r\n\t\t\t\t</section>\r\n\t\t\t</section>\r\n\t\t</section>\r\n\t\t<section style=\"text-align:left;justify-content:flex-start;display:flex;flex-flow:row;margin:30px 0px -20px;box-sizing:border-box;transform:translate3d(20px, 0px, 0px);-webkit-transform:translate3d(20px, 0px, 0px);-moz-transform:translate3d(20px, 0px, 0px);-ms-transform:translate3d(20px, 0px, 0px);-o-transform:translate3d(20px, 0px, 0px);\">\r\n\t\t\t<section style=\"display:inline-block;width:auto;vertical-align:top;min-width:10%;flex:0 0 auto;height:auto;align-self:flex-start;box-sizing:border-box;max-width:100% !important;margin-bottom:unset;\">\r\n\t\t\t\t<section style=\"text-align:justify;justify-content:flex-start;display:flex;flex-flow:row;box-sizing:border-box;margin-bottom:unset;\">\r\n\t\t\t\t\t<section style=\"display:inline-block;width:auto;vertical-align:top;min-width:10%;flex:0 0 auto;height:auto;background-color:rgb(13, 93, 183);align-self:flex-start;box-sizing:border-box;max-width:100% !important;margin-bottom:unset;\">\r\n\t\t\t\t\t\t<section style=\"color:rgba(255, 255, 255, 0.99);padding:0px 10px;letter-spacing:1px;line-height:2;box-sizing:border-box;margin-bottom:unset;\">\r\n\t\t\t\t\t\t\t<p>\r\n\t\t\t\t\t\t\t\t<span style=\"font-size:17px;\"><strong style=\"box-sizing:border-box;\">完善支持政策体系</strong></span></p>\r\n\t\t\t\t\t\t</section>\r\n\t\t\t\t\t</section>\r\n\t\t\t\t</section>\r\n\t\t\t\t<section style=\"font-size:0px;margin:0px 0%;box-sizing:border-box;\">\r\n\t\t\t\t\t<section style=\"display:inline-block;width:0px;height:0px;vertical-align:top;overflow:hidden;border-style:solid;border-width:3px;border-color:rgb(13, 93, 183) rgba(255, 255, 255, 0) rgba(255, 255, 255, 0) rgb(13, 93, 183);box-sizing:border-box;margin-bottom:unset;\">\r\n\t\t\t\t\t\t<svg style=\"float:left;line-height:0;width:0;vertical-align:top;\" viewbox=\"0 0 1 1\"></svg></section>\r\n\t\t\t\t</section>\r\n\t\t\t</section>\r\n\t\t</section>\r\n\t\t<section style=\"margin:0px 0% 10px;text-align:left;justify-content:flex-start;display:flex;flex-flow:row;box-sizing:border-box;\">\r\n\t\t\t<section data-width=\"100%\" style=\"display:inline-block;width:100%;vertical-align:top;border-left:2px solid rgb(13, 93, 183);border-bottom-left-radius:0px;padding:0px 0px 0px 2px;align-self:flex-start;flex:0 0 auto;box-sizing:border-box;margin-bottom:unset;\">\r\n\t\t\t\t<section style=\"text-align:justify;justify-content:flex-start;display:flex;flex-flow:row;box-sizing:border-box;margin-bottom:unset;\">\r\n\t\t\t\t\t<section data-width=\"100%\" style=\"display:inline-block;width:100%;vertical-align:top;border-width:0px 0px 0px 1px;border-left-style:solid;border-bottom-left-radius:0px;border-left-color:rgb(13, 93, 183);background-color:rgba(141, 191, 226, 0.15);align-self:flex-start;flex:0 0 auto;box-sizing:border-box;margin-bottom:unset;\">\r\n\t\t\t\t\t\t<section style=\"margin:30px 0% 10px;box-sizing:border-box;\">\r\n\t\t\t\t\t\t\t<section style=\"padding:0px 15px;line-height:2;letter-spacing:1.8px;font-size:15px;box-sizing:border-box;margin-bottom:unset;\">\r\n\t\t\t\t\t\t\t\t<p style=\"margin-bottom:15px;font-size:17px;text-indent:2.23529em;\">\r\n\t\t\t\t\t\t\t\t\t《意见》要求提升<strong style=\"box-sizing:border-box;\"><span style=\"color:#0D5DB7;box-sizing:border-box;\">基础设施支撑保障能力</span></strong>。盘活用好各类存量资源。加快城市停车和充换电设施建设，推动老旧设备更新改造。加强现代农事综合服务中心建设。布局建设集成高效质量基础设施，加力支持软件、研发、数据等无形资产投资。系统推进国家物流枢纽建设和功能提升，优化布局海外仓。</p>\r\n\t\t\t\t\t\t\t\t<p style=\"text-indent:2.23529em;\">\r\n\t\t\t\t\t\t\t\t\t<span style=\"font-size:17px;\"><strong style=\"box-sizing:border-box;\"><span style=\"color: rgb(13, 93, 183); box-sizing: border-box;\">推动城市一刻钟便民生活圈建设扩围升级。</span></strong>促进商品交易市场、城市零售门店、农村商业网点等更新。改造老旧街区、厂区，支持商圈、文化产业园区等业态提升。此外，还支持服务业领域符合条件的项目发行基础设施领域不动产投资信托基金（REITs）。</span></p>\r\n\t\t\t\t\t\t\t</section>\r\n\t\t\t\t\t\t</section>\r\n\t\t\t\t\t</section>\r\n\t\t\t\t</section>\r\n\t\t\t</section>\r\n\t\t</section>\r\n\t\t<section style=\"margin:20px 0px 30px;box-sizing:border-box;\">\r\n\t\t\t<section style=\"font-size:15px;color:rgba(62, 62, 62, 0.79);line-height:2;padding:0px 10px;box-sizing:border-box;margin-bottom:unset;\">\r\n\t\t\t\t<p style=\"margin-bottom:15px;font-size:17px;text-indent:2.11765em;\">\r\n\t\t\t\t\t业内人士指出，《意见》的出台，<span style=\"box-sizing:border-box;\">标志着服务业与建筑业深度融合的新阶段正式开启</span>。传统建筑业单纯依靠房地产和基建规模扩张的模式已难以为继，而服务业扩能提质所释放的工程全过程服务、老旧设施更新、节能降碳改造、适老化与文旅设施建设等需求，恰恰是建筑业向&ldquo;服务型建造&rdquo;&ldquo;绿色建造&rdquo;&ldquo;数字建造&rdquo;转型的最佳载体。</p>\r\n\t\t\t\t<p style=\"text-indent:2.11765em;\">\r\n\t\t\t\t\t<span style=\"font-size:17px;\">建筑企业应抓住政策窗口期，主动提升全过程咨询能力、数字化应用水平、绿色改造技术以及资产运营管理能力，从单一的工程承包商向投建营一体化的服务商转变，成为支撑&ldquo;中国服务&rdquo;品牌崛起的重要力量。</span></p>\r\n\t\t\t</section>\r\n\t\t</section>\r\n\t\t<section style=\"transform-origin:center center;-webkit-transform-origin:center center;-moz-transform-origin:center center;-o-transform-origin:center center;margin-top:0px;margin-bottom:0px;box-sizing:border-box;transform:scale(0.97);-webkit-transform:scale(0.97);-moz-transform:scale(0.97);-ms-transform:scale(0.97);-o-transform:scale(0.97);\">\r\n\t\t\t<section style=\"margin:4px 0% 8px;box-sizing:border-box;\">\r\n\t\t\t\t<section style=\"background-color:rgba(209, 225, 237, 0.757);height:2px;box-sizing:border-box;margin-bottom:unset;\">\r\n\t\t\t\t\t<svg style=\"float:left;line-height:0;width:0;vertical-align:top;\" viewbox=\"0 0 1 1\"></svg></section>\r\n\t\t\t</section>\r\n\t\t</section>\r\n\t\t<section style=\"margin:0px 0px 30px;box-sizing:border-box;transform:translate3d(8px, 0px, 0px);-webkit-transform:translate3d(8px, 0px, 0px);-moz-transform:translate3d(8px, 0px, 0px);-ms-transform:translate3d(8px, 0px, 0px);-o-transform:translate3d(8px, 0px, 0px);\">\r\n\t\t\t<section style=\"font-size:13px;letter-spacing:1px;text-align:left;color:rgba(62, 62, 62, 0.79);line-height:2;box-sizing:border-box;margin-bottom:unset;\">\r\n\t\t\t\t<p>\r\n\t\t\t\t\t&nbsp;</p>\r\n\t\t\t</section>\r\n\t\t</section>\r\n\t</section>\r\n</section>"}