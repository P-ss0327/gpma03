data-name=\"图层 2\"><g data-name=\"图层 1\"><g><path d=\"M38.05,0a3.38,3.38,0,1,1-3.39,3.38A3.38,3.38,0,0,1,38.05,0Z\" style=\"fill:#73d2ca;fill-rule:evenodd;\"></path></g><g><path d=\"M49.61,0a3.38,3.38,0,1,1-3.39,3.38A3.38,3.38,0,0,1,49.61,0Z\" style=\"fill:#73d2ca;fill-rule:evenodd;\"></path></g><g><path d=\"M38.05,11.47a3.38,3.38,0,1,1-3.39,3.37A3.38,3.38,0,0,1,38.05,11.47Z\" style=\"fill:#73d2ca;fill-rule:evenodd;\"></path></g><g><path d=\"M49.61,11.47a3.38,3.38,0,1,1-3.39,3.37A3.38,3.38,0,0,1,49.61,11.47Z\" style=\"fill:#73d2ca;fill-rule:evenodd;\"></path></g><g><path d=\"M3.39,22.25A3.38,3.38,0,1,1,0,25.63,3.38,3.38,0,0,1,3.39,22.25Z\" style=\"fill:#73d2ca;fill-rule:evenodd;\"></path></g><g><path d=\"M15,22.25a3.38,3.38,0,1,1-3.39,3.38A3.38,3.38,0,0,1,15,22.25Z\" style=\"fill:#73d2ca;fill-rule:evenodd;\"></path></g><g><path d=\"M26.5,22.25a3.38,3.38,0,1,1-3.41,3.38A3.4,3.4,0,0,1,26.5,22.25Z\" style=\"fill:#73d2ca;fill-rule:evenodd;\"></path></g><g><path d=\"M38.05,22.25a3.38,3.38,0,1,1-3.39,3.38A3.38,3.38,0,0,1,38.05,22.25Z\" style=\"fill:#73d2ca;fill-rule:evenodd;\"></path></g><g><path d=\"M49.61,22.25a3.38,3.38,0,1,1-3.39,3.38A3.38,3.38,0,0,1,49.61,22.25Z\" style=\"fill:#73d2ca;fill-rule:evenodd;\"></path></g></g></g></svg></section>\r\n\t\t\t\t\t</section>\r\n\t\t\t\t</section>\r\n\t\t\t</section>\r\n\t\t\t<section data-role=\"paragraph\">\r\n\t\t\t\t<p align=\"center\" style=\"text-align: center;\">\r\n\t\t\t\t\t<img class=\"rich_pages wxw-img js_insertlocalimg\" data-imgfileid=\"100013572\" data-ratio=\"1.116923076923077\" data-s=\"300,640\" data-type=\"png\" data-w=\"650\" src=\"https://www.gpma.org.cn/userfiles/1/images/cms/article/202503/1-1(1).png\" style=\"width: 650px; vertical-align: baseline; box-sizing: border-box; height: 726px;\" /></p>\r\n\t\t\t\t<p align=\"center\" style=\"text-align:center;\">\r\n\t\t\t\t\t&nbsp;</p>\r\n\t\t\t\t<section style=\"margin-bottom: 8px;\">\r\n\t\t\t\t\t<p style=\"text-indent: 2em; font-size: 17px;\">\r\n\t\t\t\t\t\t汇熙建设创立于2014年，致力于&ldquo;专业的项目管理服务&rdquo;，提供包括项目建设咨询，设计咨询以及项目管理服务。公司拥有国家注册建造师、PMP、造价师、安全工程师、高级工程师和专业的厂房及配套建设工程师。</p>\r\n\t\t\t\t</section>\r\n\t\t\t\t<section style=\"margin-bottom: 8px;\">\r\n\t\t\t\t\t<p style=\"text-indent: 2em; font-size: 17px;\">\r\n\t\t\t\t\t\t公司骨干团队曾负责多个知名企业的大型厂房建设项目，其中包括蓝月亮，百事可乐、喜力啤酒、青岛啤酒、湛江垃圾焚烧发电厂、广轻院办公楼、联英饲料厂,维他奶（武汉）新厂、维他奶（佛山）厂扩建、维他奶（东莞）新厂、可口可乐（云南）新厂、固达机械东莞新厂、GE通用电气海上风电广东揭阳基地、百事食品（四川）生产基地、百事食品（广东）生产基地、可牛了乳制品有限公司安徽项目等多个厂房建设项目。</p>\r\n\t\t\t\t</section>\r\n\t\t\t\t<section style=\"margin-bottom: 8px;\">\r\n\t\t\t\t\t<p style=\"text-indent: 2em; font-size: 17px;\">\r\n\t\t\t\t\t\t客户的信任与支持，是汇熙建设团队发展、业绩提升和规范平台打造的基础，我们始终秉承&ldquo;服务、诚信、敬业、求实&rdquo;的宗旨，为顾客创造价值。成为客户最放心的EPCM供应商。</p>\r\n\t\t\t\t</section>\r\n\t\t\t\t<p align=\"center\" style=\"text-align: center;\">\r\n\t\t\t\t\t<img class=\"rich_pages wxw-img js_insertlocalimg\" data-backh=\"204\" data-backw=\"578\" data-imgfileid=\"100013573\" data-ratio=\"0.3537037037037037\" data-s=\"300,640\" data-type=\"png\" data-w=\"1080\" src=\"https://www.gpma.org.cn/userfiles/1/images/cms/article/202503/1-2.png\" style=\"width: 1280px; vertical-align: baseline; box-sizing: border-box; height: 453px;\" /></p>\r\n\t\t\t\t<p align=\"center\" style=\"text-align:center;\">\r\n\t\t\t\t\t&nbsp;</p>\r\n\t\t\t\t<section class=\"_135editor\" data-id=\"145663\" data-role=\"title\" data-tools=\"135编辑器\">\r\n\t\t\t\t\t<section style=\"margin: 10px auto;display: flex;justify-content: center;\">\r\n\t\t\t\t\t\t<section>\r\n\t\t\t\t\t\t\t<section style=\"margin-bottom: -10px;margin-left: -10px;width: 30px;box-sizing:border-box;\">\r\n\t\t\t\t\t\t\t\t<svg style=\"display: block;\" viewbox=\"0 0 53 29\" xml:space=\"default\" xmlns=\"http://www.w3.org/2000/svg\"><g data-name=\"图层 2\"><g data-name=\"图层 1\"><g><path d=\"M3.39,0A3.38,3.38,0,1,1,0,3.38,3.38,3.38,0,0,1,3.39,0Z\" style=\"fill:#73d2ca;fill-rule:evenodd;\"></path></g><g><path d=\"M15,0a3.38,3.38,0,1,1-3.39,3.38A3.38,3.38,0,0,1,15,0Z\" style=\"fill:#73d2ca;fill-rule:ev